+const formatHeadTailOutput = (text: string, maxBytes = 64 * 1024, headBytes = 4 * 1024, tailBytes = 20 * 1024) => {
+  if (text.length <= maxBytes) return { text, truncated: false }
+  const head = text.slice(0, headBytes)
+  const tail = text.slice(-tailBytes)
+  const omitted = text.length - headBytes - tailBytes
+  return {
+    text: `${head}\n\n... [${omitted.toLocaleString()} bytes omitted for brevity; full output recorded in logs] ...\n\n${tail}`,
+    truncated: true,
+  }
+}
